# Normalize line endings across platforms
# This ensures consistent behavior when cloning on Windows/Mac/Linux

# Default: normalize to LF in repository
* text=auto eol=lf

# Force LF for specific file types
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.sql   text eol=lf
*.java  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf

# Windows-only scripts keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files - no conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.jar   binary
*.war   binary
*.joblib binary
*.pkl   binary
