# =============================================
# Mỹ Phát Hospital – Environment Variables
# Copy this file to .env and fill in real values
# DO NOT commit the real .env file to git!
# =============================================

# ── CƠ SỞ DỮ LIỆU ─────────────────────────────
# Chọn MỘT trong hai chế độ:
#
# (A) MySQL đóng gói sẵn trong Docker (dev/demo): để dòng dưới KHÔNG bị chú thích.
COMPOSE_PROFILES=local-db
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_HOST_PORT=3308
#
# (B) DÙNG DB THẬT (MySQL 8 trên server riêng / cloud / cài sẵn trên máy):
#     1. Chú thích dòng COMPOSE_PROFILES ở trên (hoặc xóa đi) để KHÔNG chạy MySQL trong Docker.
#     2. Bỏ chú thích và điền các biến dưới đây. Chạy script scripts/db/01_create_database.sql một lần để tạo DB + tài khoản.
#     3. Backend chạy trong Docker, nên:  MySQL cài trên CHÍNH máy này -> MYSQL_HOST=host.docker.internal
#                                         MySQL ở máy khác/cloud           -> MYSQL_HOST=<tên miền hoặc IP>
#        (KHÔNG dùng localhost: trong container, localhost là chính container backend.)
# MYSQL_HOST=host.docker.internal
# MYSQL_PORT=3306
# MYSQL_DB=hmsai_db
# MYSQL_SSL_MODE=PREFERRED          # DB cloud/production: REQUIRED hoặc VERIFY_CA
#
# Tài khoản ứng dụng dùng chung cho cả hai chế độ (mật khẩu mạnh, KHÔNG dùng root):
MYSQL_USER=hmsai_user
MYSQL_PASSWORD=change_me_db_password

# ── JWT (Generate a strong 256-bit random key!) ─
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_a_strong_256_bit_secret_key

# ── AI Service ────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
LLM_API_KEY=

# ── Viện phí / VietQR ─────────────────────────
# Để trống VIETQR_* = tắt thanh toán VietQR. Chỉ điền tài khoản THẬT của bệnh viện.
VIETQR_BANK_BIN=
VIETQR_BANK_NAME=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# Tài khoản THẬT: điền đủ 4 dòng trên (BIN theo NAPAS: Vietcombank 970436, MB Bank 970422, Techcombank 970407,
# BIDV 970418, VietinBank 970415, Agribank 970405, ACB 970416...), tên chủ tài khoản VIẾT HOA KHÔNG DẤU,
# rồi đặt VIETQR_DEMO=false. Có thể lấy BIN + số tài khoản bằng cách giải mã mã QR của ứng dụng ngân hàng.
# Backend tự dựng nội dung VietQR (số tiền + nội dung "MPH <mã hóa đơn>"), giao diện vẽ mã QR ngay trên trình duyệt.
# Muốn thử mã QR khi demo (KHÔNG chuyển tiền thật): bỏ chú thích 5 dòng dưới và để VIETQR_DEMO=true
# (giao diện sẽ hiện cảnh báo "Tài khoản DEMO"). Dùng tài khoản THẬT thì đặt VIETQR_DEMO=false.
# VIETQR_BANK_BIN=970422
# VIETQR_BANK_NAME=MB Bank (DEMO)
# VIETQR_ACCOUNT_NO=0000000000
# VIETQR_ACCOUNT_NAME=MY PHAT HOSPITAL DEMO
VIETQR_DEMO=false
# Mức lương cơ sở (VNĐ) dùng tính ngưỡng BHYT chi trả 100%
BHYT_BASE_SALARY=2340000

# ── Ảnh đại diện tài khoản (Cloudinary) ──────────
# Đăng ký miễn phí tại https://cloudinary.com (không cần thẻ) → Console → API Keys → copy "API environment variable".
# Để trống = tắt tải ảnh đại diện (mọi nơi hiển thị chữ cái đầu tên).
CLOUDINARY_URL=
# Thư mục chứa ảnh trên Cloudinary. Máy phát triển nên dùng thư mục riêng để không lẫn ảnh thật.
CLOUDINARY_FOLDER=myphat-hospital/dev/avatars

# ── Frontend (Vite) ───────────────────────────
# For local dev this can remain as-is
# For production, point to your deployed backend URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Hiện danh sách tài khoản demo trên form đăng nhập (chỉ dev/demo). Đặt false khi dùng CSDL thật.
VITE_SHOW_DEMO_ACCOUNTS=true

# ── Bảo mật truy cập ──────────────────────────
# Origin của giao diện web được phép gọi API từ trình duyệt (CORS), phân tách bằng dấu phẩy.
# Khi triển khai tên miền: CORS_ALLOWED_ORIGINS=https://benhvien.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# false = tắt hẳn Swagger UI và /v3/api-docs công khai (nên tắt khi dùng CSDL thật)
SWAGGER_ENABLED=true

# ── Ports ─────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8080
